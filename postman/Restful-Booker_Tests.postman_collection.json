    {
      "name": "Create booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking is created\", function () {\n    // Should be 201 per REST conventions, but the API returns 200 (see BUG-02)\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\npm.test(\"Response contains bookingid and correct data\", function () {\n    const body = pm.response.json();\n    pm.expect(body.bookingid).to.be.a(\"number\");\n    pm.expect(body.booking.firstname).to.eql(\"Feyza\");\n    pm.expect(body.booking.totalprice).to.eql(250);\n\n    // Save the booking ID as a collection variable\n    pm.collectionVariables.set(\"bookingid\", body.bookingid);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\": \"Feyza\",\n    \"lastname\": \"Akdeniz\",\n    \"totalprice\": 250,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-10\",\n        \"checkout\": \"2026-11-12\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
