      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Booking data matches what was created\", function () {\n    const body = pm.response.json();\n    pm.expect(body.firstname).to.eql(\"Feyza\");\n    pm.expect(body.lastname).to.eql(\"Akdeniz\");\n    pm.expect(body.bookingdates.checkin).to.eql(\"2026-11-10\");\n});"
            ]
          }
        }
