  "item": [
    {
      "name": "Get all bookings",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is a non-empty list\", function () {\n    const body = pm.response.json();\n    pm.expect(body).to.be.an(\"array\");\n    pm.expect(body.length).to.be.above(0);\n});\n\npm.test(\"Each item has a numeric bookingid\", function () {\n    const body = pm.response.json();\n    body.forEach(item => {\n        pm.expect(item.bookingid).to.be.a(\"number\");\n    });\n});\n\npm.test(\"Response time is below 2000 ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response contains a token\", function () {\n    const body = pm.response.json();\n    pm.expect(body.token).to.be.a(\"string\").and.not.empty;\n\n    // Save the token as a collection variable\n    pm.collectionVariables.set(\"token\", body.token);\n});"
            ]
          }
        }
      ],
